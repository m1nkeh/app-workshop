# Local dev only. Copy to .env at the repo root: cp .env.example .env
# Deployed apps get this from the platform, so .env is ignored there.

# The Lakebase branch endpoint for this app.
LAKEBASE_ENDPOINT=projects/<PROJECT>/branches/<BRANCH>/endpoints/primary

# The CLI profile you ran `databricks auth login <PROFILE>` with.
DATABRICKS_CONFIG_PROFILE=<PROFILE>

# The UC Volume for uploaded receipt files. Full three-level path
# (catalog.schema.volume) as /Volumes/<catalog>/<schema>/<volume>.
VOLUME_PATH=/Volumes/<CATALOG>/<SCHEMA>/<VOLUME>

# Owner role for the app. This is the group that will own the tables created by the app.
PGOWNER_ROLE=<owner-group-name>
